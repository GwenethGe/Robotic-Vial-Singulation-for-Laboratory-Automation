<?xml version="1.0"?>
<robot name="tube">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="tube.obj" scale="1 1 1"/>
      </geometry>
      <material name="tube_material">
        <color rgba="0.85 0.9 0.95 0.9"/>
      </material>
    </visual>
    <!-- Use simple cylinder for collision instead of mesh -->
    <!-- This prevents merging/tunneling issues -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Tube dimensions: 18mm diameter, 105mm height -->
        <cylinder radius="0.009" length="0.105"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.020"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" 
               iyy="0.00002" iyz="0" 
               izz="0.000001"/>
    </inertial>
  </link>
</robot>
